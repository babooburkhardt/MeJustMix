package com.example.mejustmix.ui

import android.graphics.Color as AndroidColor
import androidx.compose.foundation.background
import androidx.compose.foundation.border
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import com.example.mejustmix.services.SpectralData
import kotlin.math.pow

/**
 * Simplified Kubelka-Munk calibration using single-constant method.
 * 
 * User only needs to:
 * 1. Scan/photograph their pure pigment masstone
 * 2. Pick the hex color
 * 3. This dialog automatically calculates K/S ratios from RGB
 * 
 * Uses formula: K/S = (1 - R)² / (2R)
 * where R is the reflectance (0-1) for each wavelength
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun SimpleKMCalibrationDialog(
    pigmentName: String,
    currentColor: Int,
    onCalibrated: (SpectralData) -> Unit,
    onDismissRequest: () -> Unit
) {
    var hexInput by remember { mutableStateOf(String.format("#%06X", currentColor and 0xFFFFFF)) }
    var previewColor by remember { mutableStateOf(currentColor) }
    var errorMessage by remember { mutableStateOf<String?>(null) }
    
    AlertDialog(
        onDismissRequest = onDismissRequest,
        modifier = Modifier.fillMaxWidth(0.9f)
    ) {
        Surface(
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(16.dp),
            tonalElevation = 6.dp
        ) {
            Column(
                modifier = Modifier
                    .padding(24.dp)
                    .fillMaxWidth(),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                // Header
                Text(
                    text = "Calibrate $pigmentName",
                    style = MaterialTheme.typography.headlineSmall,
                    fontWeight = FontWeight.Bold
                )
                
                Text(
                    text = "Easy 3-Step Calibration",
                    style = MaterialTheme.typography.titleMedium,
                    color = MaterialTheme.colorScheme.primary
                )
                
                // Instructions
                Card(
                    colors = CardDefaults.cardColors(
                        containerColor = MaterialTheme.colorScheme.secondaryContainer
                    )
                ) {
                    Column(
                        modifier = Modifier.padding(16.dp),
                        verticalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        InstructionStep(
                            number = "1",
                            text = "Apply pure $pigmentName to white paper (thick enough you can't see through)"
                        )
                        InstructionStep(
                            number = "2",
                            text = "Scan it or photograph in even daylight (no shadows/flash)"
                        )
                        InstructionStep(
                            number = "3",
                            text = "Use a color picker to get the hex code and paste below"
                        )
                    }
                }
                
                // Color input
                Text(
                    text = "Measured Color",
                    style = MaterialTheme.typography.labelLarge,
                    fontWeight = FontWeight.Bold
                )
                
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(12.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    OutlinedTextField(
                        value = hexInput,
                        onValueChange = { input ->
                            hexInput = input
                            // Try to parse color
                            try {
                                val color = AndroidColor.parseColor(input)
                                previewColor = color
                                errorMessage = null
                            } catch (e: Exception) {
                                errorMessage = "Invalid hex code"
                            }
                        },
                        label = { Text("Hex Code") },
                        placeholder = { Text("#00B7EB") },
                        modifier = Modifier.weight(1f),
                        singleLine = true,
                        isError = errorMessage != null
                    )
                    
                    // Color preview
                    Box(
                        modifier = Modifier
                            .size(60.dp)
                            .background(Color(previewColor), RoundedCornerShape(8.dp))
                            .border(2.dp, MaterialTheme.colorScheme.outline, RoundedCornerShape(8.dp))
                    )
                }
                
                if (errorMessage != null) {
                    Text(
                        text = errorMessage!!,
                        style = MaterialTheme.typography.bodySmall,
                        color = MaterialTheme.colorScheme.error
                    )
                }
                
                // Technical details (collapsible)
                var showDetails by remember { mutableStateOf(false) }
                
                TextButton(onClick = { showDetails = !showDetails }) {
                    Text(if (showDetails) "Hide Technical Details" else "Show Technical Details")
                }
                
                if (showDetails) {
                    Card(
                        colors = CardDefaults.cardColors(
                            containerColor = MaterialTheme.colorScheme.surfaceVariant
                        )
                    ) {
                        Column(
                            modifier = Modifier.padding(12.dp),
                            verticalArrangement = Arrangement.spacedBy(4.dp)
                        ) {
                            Text(
                                "How it works:",
                                style = MaterialTheme.typography.labelMedium,
                                fontWeight = FontWeight.Bold
                            )
                            Text(
                                "• RGB values → Reflectance (R) at each wavelength",
                                style = MaterialTheme.typography.bodySmall
                            )
                            Text(
                                "• K/S ratio = (1 - R)² / (2R)",
                                style = MaterialTheme.typography.bodySmall
                            )
                            Text(
                                "• Calculates 31 wavelengths (400-700nm)",
                                style = MaterialTheme.typography.bodySmall
                            )
                            Text(
                                "• Assumes S = constant (typical for most paints)",
                                style = MaterialTheme.typography.bodySmall
                            )
                        }
                    }
                }
                
                // Action buttons
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    OutlinedButton(
                        onClick = onDismissRequest,
                        modifier = Modifier.weight(1f)
                    ) {
                        Text("Cancel")
                    }
                    
                    Button(
                        onClick = {
                            if (errorMessage == null) {
                                val spectralData = calculateKSFromColor(previewColor, pigmentName)
                                onCalibrated(spectralData)
                                onDismissRequest()
                            }
                        },
                        modifier = Modifier.weight(1f),
                        enabled = errorMessage == null
                    ) {
                        Text("Calibrate")
                    }
                }
            }
        }
    }
}

@Composable
private fun InstructionStep(number: String, text: String) {
    Row(
        horizontalArrangement = Arrangement.spacedBy(12.dp),
        verticalAlignment = Alignment.Top
    ) {
        Box(
            modifier = Modifier
                .size(24.dp)
                .background(MaterialTheme.colorScheme.primary, RoundedCornerShape(12.dp)),
            contentAlignment = Alignment.Center
        ) {
            Text(
                text = number,
                style = MaterialTheme.typography.labelSmall,
                color = MaterialTheme.colorScheme.onPrimary,
                fontWeight = FontWeight.Bold
            )
        }
        Text(
            text = text,
            style = MaterialTheme.typography.bodyMedium,
            modifier = Modifier.weight(1f)
        )
    }
}

/**
 * Calculate K/S ratios from measured RGB color using single-constant method.
 * 
 * This uses the simplified Kubelka-Munk equation:
 * K/S = (1 - R)² / (2R)
 * 
 * We assume S is constant and derive K values to match the measured color.
 */
private fun calculateKSFromColor(colorInt: Int, pigmentName: String): SpectralData {
    val r = AndroidColor.red(colorInt) / 255f
    val g = AndroidColor.green(colorInt) / 255f
    val b = AndroidColor.blue(colorInt) / 255f
    
    // Standard wavelengths (400-700nm in 10nm steps)
    val wavelengths = (400..700 step 10).toList()
    
    // Convert RGB to approximate reflectance at each wavelength
    val reflectances = wavelengths.map { wavelength ->
        approximateReflectanceAtWavelength(wavelength, r, g, b)
    }
    
    // Choose appropriate S value based on pigment type
    // White has very high scattering, others are moderate
    val baseS = when {
        pigmentName.contains("White", ignoreCase = true) -> 15.0f
        pigmentName.contains("Black", ignoreCase = true) -> 0.5f
        else -> 2.0f
    }
    
    // Calculate K/S ratio, then derive K values
    val kValues = reflectances.map { R ->
        // Handle edge cases
        val safeR = R.coerceIn(0.01f, 0.99f)
        
        // K/S = (1 - R)² / (2R)
        val ksRatio = (1f - safeR).pow(2) / (2f * safeR)
        
        // K = (K/S) × S
        val k = ksRatio * baseS
        
        // Ensure K is positive and reasonable
        k.coerceIn(0.05f, 30.0f)
    }
    
    // S values are constant
    val sValues = wavelengths.map { baseS }
    
    return SpectralData(wavelengths, kValues, sValues)
}

/**
 * Approximate reflectance at a specific wavelength from RGB.
 * 
 * Uses a simplified model:
 * - Blue channel dominates at 400-500nm
 * - Green channel dominates at 500-580nm  
 * - Red channel dominates at 580-700nm
 * 
 * This is an approximation but works well for calibration purposes.
 */
private fun approximateReflectanceAtWavelength(
    wavelength: Int,
    r: Float,
    g: Float,
    b: Float
): Float {
    return when {
        // Violet/Blue region (400-500nm)
        wavelength < 500 -> {
            val blueWeight = 1.0f - (wavelength - 400) / 100f
            val greenWeight = (wavelength - 400) / 100f
            (b * blueWeight + g * greenWeight * 0.3f).coerceIn(0f, 1f)
        }
        
        // Green region (500-580nm)
        wavelength < 580 -> {
            val greenWeight = 1.0f - (wavelength - 500) / 80f
            val redWeight = (wavelength - 500) / 80f * 0.5f
            val blueWeight = 0.2f
            (g * greenWeight + r * redWeight + b * blueWeight * (1f - greenWeight)).coerceIn(0f, 1f)
        }
        
        // Red region (580-700nm)
        else -> {
            val redWeight = 0.7f + (wavelength - 580) / 120f * 0.3f
            val greenWeight = 1.0f - redWeight
            (r * redWeight + g * greenWeight * 0.4f).coerceIn(0f, 1f)
        }
    }
}
