package com.example.mejustmix.services

import android.graphics.Color
import androidx.core.graphics.ColorUtils
import com.example.mejustmix.data.PaintMix
import kotlin.math.max
import kotlin.math.min
import kotlin.math.pow

// This class MUST be here or imported correctly for SettingsViewModel to work
data class PigmentStrengths(
    val cyan: Float = 3.5f,
    val magenta: Float = 2.5f,
    val yellow: Float = 1.0f,
    val black: Float = 5.0f,
    val white: Float = 1.0f,
    val gamma: Float = 1.0f 
)

/**
 * Unified color mixing service supporting both simple RGB-based mixing
 * and advanced Kubelka-Munk spectral mixing.
 */
object ColorMixingService {

    private const val PIGMENT_MASSTONE_LIGHTNESS = 0.25f
    private const val MIN_TOTAL_VOLUME = 0.0001f

    // Cached Kubelka-Munk database (loaded on first use)
    private var kmDatabase: KubelkaMunkPigmentDatabase? = null

    /**
     * Main entry point for color mixing calculation.
     * 
     * @param colorInt Android color integer (ARGB)
     * @param strengths Pigment strength multipliers
     * @param useKubelkaMunk If true, use spectral Kubelka-Munk theory; if false, use simple RGB
     * @return Normalized paint mix ratios
     */
    fun calculateMixRatios(
        colorInt: Int, 
        strengths: PigmentStrengths,
        useKubelkaMunk: Boolean = false
    ): PaintMix {
        return if (useKubelkaMunk) {
            calculateKubelkaMunkMix(colorInt, strengths)
        } else {
            calculateSimpleMix(colorInt, strengths)
        }
    }

    /**
     * Calculate mix using Kubelka-Munk spectral theory.
     */
    private fun calculateKubelkaMunkMix(
        colorInt: Int,
        strengths: PigmentStrengths
    ): PaintMix {
        // Lazy load database
        if (kmDatabase == null) {
            kmDatabase = KubelkaMunkColorMixing.createDefaultPigmentDatabase()
        }
        
        // Scale database by pigment strengths
        val scaledDatabase = KubelkaMunkColorMixing.scalePigmentDatabase(
            kmDatabase!!,
            strengths
        )
        
        // Calculate optimal mix
        return KubelkaMunkColorMixing.calculateMixRatios(colorInt, scaledDatabase)
    }

    /**
     * Calculate mix using simple RGB-based algorithm (original method).
     * 
     * Algorithm:
     * 1. Apply gamma correction to RGB values
     * 2. Calculate perceptual lightness using HSL
     * 3. Separate color into CMYK components
     * 4. Calculate white needed to achieve target lightness
     * 5. Apply pigment strength corrections
     * 6. Normalize to sum to 1.0
     */
    private fun calculateSimpleMix(
        colorInt: Int,
        strengths: PigmentStrengths
    ): PaintMix {
        // 1. Normalize RGB to 0.0 - 1.0 and apply Gamma Correction
        val r = (Color.red(colorInt) / 255f).pow(strengths.gamma)
        val g = (Color.green(colorInt) / 255f).pow(strengths.gamma)
        val b = (Color.blue(colorInt) / 255f).pow(strengths.gamma)

        // 2. Calculate HSL for Perceptual Lightness
        val hsl = FloatArray(3)
        ColorUtils.RGBToHSL(
            Color.red(colorInt), 
            Color.green(colorInt), 
            Color.blue(colorInt), 
            hsl
        )
        val lightness = hsl[2] 

        // 3. Determine "Optical" Components (CMYK separation)
        val maxVal = max(r, max(g, b))
        val opticalC = (maxVal - r)
        val opticalM = (maxVal - g)
        val opticalY = (maxVal - b)
        val opticalK = 1f - maxVal

        // 4. White Calculation
        // If color is lighter than pure pigment masstone, add white
        val neededWhite = if (lightness > PIGMENT_MASSTONE_LIGHTNESS) {
            (lightness - PIGMENT_MASSTONE_LIGHTNESS) / (1f - PIGMENT_MASSTONE_LIGHTNESS)
        } else {
            0f
        }
        
        val baseWhite = min(r, min(g, b)) 
        val opticalW = max(baseWhite, neededWhite)

        // 5. Apply Tunable Strengths
        // Stronger pigments need less volume to achieve same color
        var volC = opticalC / strengths.cyan
        var volM = opticalM / strengths.magenta
        var volY = opticalY / strengths.yellow
        var volK = opticalK / strengths.black
        var volW = opticalW / strengths.white

        // 6. Normalization (with safety check for division by zero)
        val totalVolume = volC + volM + volY + volK + volW

        return if (totalVolume > MIN_TOTAL_VOLUME) {
            PaintMix(
                cyan = volC / totalVolume,
                magenta = volM / totalVolume,
                yellow = volY / totalVolume,
                black = volK / totalVolume,
                white = volW / totalVolume
            )
        } else {
            // Fallback for extreme edge cases
            PaintMix(0f, 0f, 0f, 0f, 1f) 
        }
    }
    
    /**
     * Preview the resulting color from a paint mix.
     * Works for both mixing methods.
     */
    fun previewMixedColor(
        mix: PaintMix,
        useKubelkaMunk: Boolean = false
    ): Int {
        return if (useKubelkaMunk && kmDatabase != null) {
            val reflectance = KubelkaMunkColorMixing.calculateReflectance(mix, kmDatabase!!)
            KubelkaMunkColorMixing.reflectanceToRGB(reflectance)
        } else {
            // Simple RGB blending for preview
            val r = ((1f - mix.cyan) * (1f - mix.black) * (1f - mix.white + mix.white) * 255).toInt().coerceIn(0, 255)
            val g = ((1f - mix.magenta) * (1f - mix.black) * (1f - mix.white + mix.white) * 255).toInt().coerceIn(0, 255)
            val b = ((1f - mix.yellow) * (1f - mix.black) * (1f - mix.white + mix.white) * 255).toInt().coerceIn(0, 255)
            Color.rgb(r, g, b)
        }
    }
}
